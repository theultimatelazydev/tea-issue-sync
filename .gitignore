# Synced issue mirror — a local read-cache; Gitea is the source of truth.
# Remove this line only if you want issues-as-code (diffable, offline, in CI).
.issues-tea/

# Secrets. Tokens are resolved at runtime ($GITEA_TOKEN or tea's config.yml)
# and must never be committed.
.env
.env.*

# Per-machine config overrides (real instance URL lives here, not in config.json).
config.local.json

# Compiled binaries (make build / make dist)
dist/
/tea-issue-sync

# Stray bun compile artifacts (from the pre-Go prototype)
*.bun-build

# Claude Code workspace
.claude/worktrees/
.claude/settings.local.json

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
